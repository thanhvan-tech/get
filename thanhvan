#!/usr/bin/env bash
#
# thanhvan -- one front door to gcloud, gh, tailscale, cloudflared, ssh, kubectl,
# git, helm, jq and yq.
#
# This script IS the CLI. It installs nothing, authenticates nothing and knows
# nothing about any of the four services; it composes one `docker run` and gets
# out of the way. Everything a user can actually do lives in the image.
#
# ===========================================================================
# WRITE FOR BASH 3.2.
#
# macOS ships 3.2.57 (2007) as /bin/bash and always will -- bash 4 went GPLv3.
# So: no associative arrays, no ${x,,}, no mapfile, no &>>, no negative array
# indices, no `local -n`. Indexed arrays and ${!var} are fine, both predate 3.2.
#
# Ubuntu has bash 5 and accepts all of the above, which is exactly why this is
# easy to get wrong: it works on the machine you tested and breaks on the other.
# ===========================================================================
#
# ===========================================================================
# TWO INVARIANTS, BOTH GUARDED IN CI, NEITHER OF WHICH FAILS LOUDLY IF BROKEN:
#
#  1. NO BIND MOUNTS, EVER. Not the cwd, not $HOME, not one host path. All state
#     lives in the named volume, which is the only writable thing the container
#     can see and which `docker volume rm` removes completely. That is what
#     makes "thanhvan touched nothing on my laptop" a true statement and what
#     makes uninstall a real operation instead of a hunt through four dotfile
#     directories.
#
#     `container cp`, --push and --pull are NOT an exception to this and must
#     never become one. No host path is mounted; THIS SCRIPT, running on the
#     host, reads a file the user named and streams its bytes over the
#     container's stdin. The container gains no ability to see the host
#     filesystem -- only bytes the user asked for, by name, in the command they
#     typed. The moment a path the user did not type is read, or a mount is
#     added "to make cp faster", that property is gone and nothing at runtime
#     notices.
#
#  2. NO ADDED PRIVILEGES. No --privileged, --cap-add, --device, --network=host,
#     --security-opt, no docker.sock. tailscaled runs with
#     --tun=userspace-networking, which needs none of them.
#
# A change that violates either one still works perfectly on the machine you
# test it on. That is the whole problem.
# ===========================================================================

set -u

THANHVAN_VERSION="0.8.0"

IMAGE_REPO="ghcr.io/thanhvan-tech/thanhvan"
DEFAULT_VOLUME="thanhvan-home"
CHOME="/home/thanhvan"

# Where `thanhvan update` looks for a newer launcher: the SAME public channel
# install/install.sh downloads from, verified the same way. install.sh is the
# entire distribution channel, so an update path that checked less than the
# install does would be a way around the install's verification -- available on
# every machine that already has thanhvan. Public by design; no credentials.
UPDATE_BASE_URL="${THANHVAN_UPDATE_URL:-https://raw.githubusercontent.com/thanhvan-tech/get/main}"

# Host environment forwarded into the container. AN ALLOWLIST, and deliberately
# tiny. Forwarding the environment wholesale would put whatever the host happens
# to be holding -- GITHUB_TOKEN, AWS_SECRET_ACCESS_KEY, a CI job's injected
# secrets -- into `docker run`'s argv, which every user on the machine can read
# through ps(1) for the lifetime of the call. Adding a name to this list is a
# security decision, not a convenience one.
FORWARD_ENV="TERM NO_COLOR HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy"

# The verbs. Each is a program in the image. `tailscale` and `ssh` are the two
# that need a wrapper: the tailscale CLI is useless without a daemon, and ssh
# cannot reach a tailnet address without one either. See docker/tv-net.sh.
#
# A name here is a name thanhvan will never pass to anything else, so adding one
# is a decision about the boundary, not just about a tool. `run` and `shell` are
# deliberately NOT here -- they are dispatched in main(), because a verb's argv
# is untouched from the verb onward and `thanhvan run --dry-run ls` has to mean
# `--dry-run` belongs to the container's command, not to us.
PASSTHROUGH_VERBS="gcloud gh tailscale cloudflared ssh kubectl git helm jq yq"

# Where --push lands and `container cp tv:...` defaults to. Relative to $CHOME,
# which is also the container's working directory -- so a vendor command can
# refer to a pushed file as `data/sa.json` and have it resolve.
DATA_DIR="data"

TV_DRY_RUN=0
TV_QUIET=0
TV_YES=0
TV_TAILNET=0
TV_FORCE=0
TV_RECURSE=0

# Newline-delimited, one `src[:dest]` per line. Not arrays: these are read back
# in run_passthrough, and bash 3.2 has no `local -n` to pass an array by name.
# Initialised, not merely declared -- `set -u` aborts on the first read of an
# unset variable, and both of these are read on every passthrough call.
TV_PUSH=""
TV_PULL=""

# cmd_update's scratch directory. GLOBAL on purpose, and this is not a style
# choice: an EXIT trap fires AFTER the function that installed it has returned,
# so a `local tmp` is already out of scope by then. Under `set -u` the trap
# then aborts with "tmp: unbound variable" -- printed after a successful
# update, looking like the update broke, having cleaned up nothing.
TV_UPD_TMP=""
NL='
'

# --- self-resolution ------------------------------------------------------
# Installed, this file is reached through two symlink hops:
#
#   ~/.local/bin/thanhvan -> ~/.local/share/thanhvan/current/bin/thanhvan
#                         -> ~/.local/share/thanhvan/versions/<v>/bin/thanhvan
#
# so `dirname "$0"` yields ~/.local/bin and every path derived from it is wrong.
# `readlink -f` does not exist on macOS < 12.3 and BSD `realpath` has no -f, so
# walk the chain by hand. This works perfectly from a checkout and breaks every
# installed run, which is the worst way to be wrong -- CI drives the real
# symlink chain because of it.
_self="$0"
while [ -L "$_self" ]; do
  _dir=$(cd -P "$(dirname "$_self")" && pwd)
  _self=$(readlink "$_self")
  case "$_self" in
    /*) ;;                     # absolute target, use as-is
    *) _self="$_dir/$_self" ;; # relative target, resolve against the link's dir
  esac
done
BIN_DIR=$(cd -P "$(dirname "$_self")" && pwd)
CLI_ROOT=$(cd -P "$BIN_DIR/.." && pwd)

if [ -d "$CLI_ROOT/.git" ]; then TV_MODE="dev"; else TV_MODE="installed"; fi

# --- output ---------------------------------------------------------------

if [ -t 2 ]; then
  C_DIM=$'\033[2m'; C_RED=$'\033[31m'; C_YEL=$'\033[33m'
  C_GRN=$'\033[32m'; C_BOLD=$'\033[1m'; C_OFF=$'\033[0m'
else
  C_DIM=''; C_RED=''; C_YEL=''; C_GRN=''; C_BOLD=''; C_OFF=''
fi

# Chrome on stderr, data on stdout, so `thanhvan gh api user | jq` works.
say()     { [ "$TV_QUIET" = "1" ] || printf '%s\n' "$*" >&2; }
heading() { [ "$TV_QUIET" = "1" ] || printf '\n%s%s%s\n' "$C_BOLD" "$*" "$C_OFF" >&2; }
ok()      { [ "$TV_QUIET" = "1" ] || printf '  %s+%s %s\n' "$C_GRN" "$C_OFF" "$*" >&2; }
miss()    { [ "$TV_QUIET" = "1" ] || printf '  %s-%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; }
skip()    { [ "$TV_QUIET" = "1" ] || printf '  %s.%s %s\n' "$C_DIM" "$C_OFF" "$*" >&2; }
bullet()  { [ "$TV_QUIET" = "1" ] || printf '    %s-%s %s\n' "$C_DIM" "$C_OFF" "$*" >&2; }
warn()    { printf '%swarning:%s %s\n' "$C_YEL" "$C_OFF" "$*" >&2; }

# Errors name the exact command that fixes them. These often surface in a CI log
# where there is nobody to ask a follow-up question.
die() { printf '%serror:%s %s\n' "$C_RED" "$C_OFF" "$1" >&2; shift
        for _l in "$@"; do printf '  %s\n' "$_l" >&2; done
        exit 1; }

confirm() {
  # question, default(y|n). --yes answers yes. Non-interactive answers with the
  # default, and every destructive caller passes n -- so an unattended run that
  # forgot --yes changes nothing rather than guessing.
  [ "$TV_YES" = "1" ] && return 0
  [ -t 0 ] || { [ "${2:-n}" = "y" ]; return $?; }
  # reply is initialised, not merely declared: `local reply` leaves it UNSET, and
  # `set -u` aborts on the first read of an unset variable.
  local suffix reply=""
  if [ "${2:-n}" = "y" ]; then suffix="[Y/n]"; else suffix="[y/N]"; fi
  printf '  %s %s ' "$1" "$suffix" >&2
  read -r reply || return 1
  [ -z "$reply" ] && { [ "${2:-n}" = "y" ]; return $?; }
  case "$reply" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

confirm_phrase() {
  # Reserved for what cannot be undone. A y/N prompt gets answered reflexively;
  # typing a word does not. Never passes non-interactively, --yes included.
  [ -t 0 ] || return 1
  local reply=""
  printf '  %s\n  Type %s%s%s to continue: ' "$1" "$C_BOLD" "$2" "$C_OFF" >&2
  read -r reply || return 1
  [ "$reply" = "$2" ]
}

# --- machine detection ----------------------------------------------------

detect() {
  case "$(uname -s)" in
    Darwin) TV_OS="macos" ;;
    Linux)
      TV_OS="linux"
      if [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        case "${ID:-}" in
          ubuntu|debian) TV_OS="$ID" ;;
          *) case " ${ID_LIKE:-} " in *" debian "*|*" ubuntu "*) TV_OS="debian" ;; esac ;;
        esac
      fi ;;
    *) TV_OS="unknown" ;;
  esac

  case "$(uname -m)" in
    arm64|aarch64) TV_ARCH="arm64" ;;
    x86_64|amd64)  TV_ARCH="amd64" ;;
    *) TV_ARCH="$(uname -m)" ;;
  esac

  # The LOGIN shell, not this one -- $SHELL is what the user gets in a new
  # terminal, which is where the PATH block has to take effect.
  TV_SHELL="$(basename "${SHELL:-}")"
  case "$TV_SHELL" in
    zsh)  TV_RC="$HOME/.zshrc" ;;
    bash) if [ "$TV_OS" = "macos" ]; then TV_RC="$HOME/.bash_profile"; else TV_RC="$HOME/.bashrc"; fi ;;
    *)    TV_RC="" ;;
  esac

  # Not a terminal means nobody can answer a prompt, whether or not $CI is set.
  if [ -n "${CI:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ] || [ ! -t 0 ]; then
    TV_CI=1
  else
    TV_CI=0
  fi
}

image_ref() { printf '%s' "${THANHVAN_IMAGE:-$IMAGE_REPO:$THANHVAN_VERSION}"; }
volume_name() { printf '%s' "${THANHVAN_VOLUME:-$DEFAULT_VOLUME}"; }

detect_report() {
  detect
  printf 'os=%s\n'       "$TV_OS"
  printf 'arch=%s\n'     "$TV_ARCH"
  printf 'shell=%s\n'    "$TV_SHELL"
  printf 'rc=%s\n'       "$TV_RC"
  printf 'ci=%s\n'       "$TV_CI"
  printf 'mode=%s\n'     "$TV_MODE"
  printf 'cli_root=%s\n' "$CLI_ROOT"
  printf 'version=%s\n'  "$THANHVAN_VERSION"
  printf 'image=%s\n'    "$(image_ref)"
  printf 'volume=%s\n'   "$(volume_name)"
}

# --- the shell PATH block -------------------------------------------------
# A marked block, rewritten by sed range-delete then append, so re-running
# replaces it rather than stacking a second copy.

BLOCK_BEGIN="# >>> thanhvan >>>"
BLOCK_END="# <<< thanhvan <<<"

write_shell_block() {
  detect
  [ -n "$TV_RC" ] || return 0
  # A CI runner has no interactive shell to fix, and editing a profile there is
  # pure surprise.
  [ "$TV_CI" = "1" ] && return 0

  local bindir="$HOME/.local/bin"
  case ":$PATH:" in *":$bindir:"*) return 0 ;; esac

  remove_shell_block
  {
    printf '\n%s\n' "$BLOCK_BEGIN"
    # $PATH must reach the rc file literally, not expanded at write time.
    # shellcheck disable=SC2016
    printf 'export PATH="%s:$PATH"\n' "$bindir"
    printf '%s\n' "$BLOCK_END"
  } >> "$TV_RC"
  ok "added $bindir to PATH in $TV_RC"
}

remove_shell_block() {
  detect
  [ -n "$TV_RC" ] || return 0
  [ -f "$TV_RC" ] || return 0
  grep -qF "$BLOCK_BEGIN" "$TV_RC" 2>/dev/null || return 0
  local tmp
  tmp="$TV_RC.thanhvan.$$"
  sed "/^${BLOCK_BEGIN}\$/,/^${BLOCK_END}\$/d" "$TV_RC" > "$tmp" && mv -f "$tmp" "$TV_RC"
}

# --- docker ---------------------------------------------------------------

require_docker() {
  # TWO problems, TWO fixes, and conflating them sends people to the wrong one.
  # Telling somebody who has Docker Desktop installed but closed to "install
  # Docker" costs them an afternoon.
  if ! command -v docker >/dev/null 2>&1; then
    detect
    if [ "$TV_OS" = "macos" ]; then
      die "docker is not installed." \
          "thanhvan runs every tool in a container so that nothing is installed on" \
          "this machine. Docker is the one exception, and the only prerequisite." \
          "" \
          "  brew install --cask docker      (or orbstack, or colima)"
    fi
    die "docker is not installed." \
        "thanhvan runs every tool in a container so that nothing is installed on" \
        "this machine. Docker is the one exception, and the only prerequisite." \
        "" \
        "  https://docs.docker.com/engine/install/"
  fi

  if ! docker info >/dev/null 2>&1; then
    detect
    if [ "$TV_OS" = "macos" ]; then
      die "docker is installed, but its daemon is not reachable." \
          "Start it and try again:  open -a Docker"
    fi
    die "docker is installed, but its daemon is not reachable." \
        "Start it:            sudo systemctl start docker" \
        "If that says permission denied, add yourself to the docker group:" \
        "                     sudo usermod -aG docker \$USER   (then log out and back in)"
  fi
}

ensure_volume() {
  local name; name="$(volume_name)"
  if docker volume inspect "$name" >/dev/null 2>&1; then
    return 0
  fi
  [ "$TV_DRY_RUN" = "1" ] && { say "dry-run: docker volume create $name"; return 0; }
  # `docker run -v name:path` would create it implicitly, unlabelled. Creating it
  # here means `docker volume ls --filter label=app=thanhvan` finds everything
  # thanhvan owns, which is what makes a clean uninstall possible at all.
  docker volume create --label app=thanhvan "$name" >/dev/null \
    || die "could not create the docker volume '$name'."
}

image_present() { docker image inspect "$(image_ref)" >/dev/null 2>&1; }

require_image() {
  image_present && return 0
  [ "$TV_DRY_RUN" = "1" ] && return 0
  # Deliberately does NOT pull. A silent ~800MB download in the middle of
  # `thanhvan gcloud config list` is not something anyone should have to work out
  # from a stalled terminal.
  die "the thanhvan tool image is not present ($(image_ref))." \
      "Pull it:  thanhvan setup workstation"
}

pull_image() {
  # Takes an explicit ref so `update` can pull the image for the version it just
  # installed rather than for the one this process is running. Defaulted, so
  # every existing caller means what it always did.
  local ref="${1:-$(image_ref)}"
  if [ "$TV_DRY_RUN" = "1" ]; then say "dry-run: docker pull $ref"; return 0; fi
  docker pull "$ref" || die "could not pull $ref." \
    "If this is a private registry you are not logged in to:  docker login ghcr.io"
}

quoted() {
  # Display-only shell quoting, for --dry-run and -v traces.
  local out="" a
  for a in "$@"; do
    case "$a" in
      *[!A-Za-z0-9_./:=-]*|'') out="$out '$(printf '%s' "$a" | sed "s/'/'\\\\''/g")'" ;;
      *) out="$out $a" ;;
    esac
  done
  printf '%s' "${out# }"
}

# THE ONLY PLACE A CONTAINER IS STARTED.
#
# Every flag below is part of the security boundary, and CI asserts that this
# function is the single site that has one. Do not add a second.
docker_run() {
  local -a args
  args=( --rm )

  # -i always; -t only when BOTH ends are a terminal. Two different failures,
  # one on each side:
  #
  #   -t with a redirected stdin -- `thanhvan gcloud ... < /dev/null`, or any CI
  #      run -- makes docker refuse outright: "the input device is not a TTY".
  #
  #   -t with a redirected stdout allocates a pty, and a pty rewrites every \n
  #      as \r\n. So `thanhvan gcloud ... --format=json | jq` fails on carriage
  #      returns inside the JSON, which reads as a gcloud bug and is not one.
  #
  # -i is kept in every case, so `echo y | thanhvan gcloud ...` still works.
  if [ -t 0 ] && [ -t 1 ]; then args+=( -i -t ); else args+=( -i ); fi

  # --init: the tailscale wrapper leaves a background tailscaled behind, and
  #   without an init to reap it the container outlives the command.
  # --hostname: otherwise tailscaled registers a NEW device named after each
  #   container id, and the tailnet slowly fills with one-shot nodes.
  args+=( --init --hostname thanhvan )

  # The only mount. A named volume, never a host path.
  args+=( -v "$(volume_name):$CHOME" -w "$CHOME" )

  local name value
  for name in $FORWARD_ENV; do
    value="${!name:-}"
    [ -n "$value" ] && args+=( -e "$name=$value" )
  done

  args+=( "$(image_ref)" "$@" )

  if [ "$TV_DRY_RUN" = "1" ]; then
    say "dry-run: docker run $(quoted "${args[@]}")"
    return 0
  fi
  [ "${TV_TRACE:-0}" = "1" ] && say "$C_DIM\$$C_OFF docker run $(quoted "${args[@]}")"

  docker run "${args[@]}"
}

# --- moving data in and out -----------------------------------------------
#
# THE BYTES GO OVER stdin/stdout. THEY NEVER GO OVER argv.
#
# `docker run`'s argv is readable through ps(1) by every user on the machine for
# the lifetime of the call. That is why FORWARD_ENV is an allowlist rather than
# the environment; the identical argument applies to file CONTENTS, and harder,
# because the files this moves are SSH private keys and kubeconfigs. So nothing
# below ever interpolates a file into a command line -- a `$(cat ...)` anywhere
# in this script is the bug, and CI greps for it.
#
# docker_run allocates a pty only when BOTH stdin and stdout are terminals. Every
# copy below has one or the other redirected, so none of them gets one -- which
# matters more here than anywhere else in this file: a pty rewrites every \n as
# \r\n, and that silently corrupts any binary this moves.

# Reject a container-side path that is not plainly under $CHOME.
#
# docker/tv-cp.sh checks this again, and the duplication is the point: this copy
# fails BEFORE a container is started, so a typo costs nothing and the error is
# immediate, while that one holds however tv-cp is reached.
check_rel() {
  local p="$1" rest c
  [ -n "$p" ] || die "empty container path." \
    "Container paths are relative to $CHOME, e.g. tv:$DATA_DIR/sa.json"
  case "$p" in
    /*) die "'$p' is an absolute container path." \
            "Container paths are relative to $CHOME, e.g. tv:$DATA_DIR/sa.json" ;;
  esac
  # Component-wise, not a substring test: '..foo' is an ordinary file name, and a
  # guard that rejects it is one people work around rather than fix.
  rest="$p"
  while [ -n "$rest" ]; do
    c="${rest%%/*}"
    [ "$c" = ".." ] && die "'$p' contains a '..' component." \
                           "Container paths must stay inside $CHOME."
    case "$rest" in
      */*) rest="${rest#*/}" ;;
      *)   rest="" ;;
    esac
  done
  return 0
}

host_tmp() {
  # BSD mktemp needs a template; `mktemp -d` alone is a GNU-ism that fails on
  # macOS with a usage message, which is exactly the class of difference this
  # repo keeps getting caught by.
  mktemp -d "${TMPDIR:-/tmp}/thanhvan.XXXXXX"
}

# Everything the container sends is UNTRUSTED on the way out.
#
# It is the less-privileged side of the stream, but it is also the side this
# script cannot see into, and a tar is a file format with a documented history of
# writing outside the directory it was extracted into. Scan before extracting;
# do not rely on tar's own stripping, which differs between GNU tar and the
# bsdtar on macOS.
scan_tar() {
  local f="$1" bad=""
  bad="$(tar -tf "$f" 2>/dev/null \
         | grep -e '^/' -e '^\.\.$' -e '^\.\./' -e '/\.\./' -e '/\.\.$' \
         | head -3)"
  if [ -n "$bad" ]; then
    die "the archive from the container names paths outside the destination." \
        "$bad" \
        "Nothing was written. This should not happen; the volume may be tampered with."
  fi
  bad="$(tar -tvf "$f" 2>/dev/null | grep -E '^[lh]' | head -3)"
  if [ -n "$bad" ]; then
    die "the archive from the container contains links, which are not copied out." \
        "$bad"
  fi
  return 0
}

# host -> container. src is a host path; rel is relative to $CHOME.
copy_in() {
  local src="$1" rel="$2" mode="$3" force="$4"
  check_rel "$rel"
  [ -e "$src" ] || die "no such file or directory: $src"

  if [ -d "$src" ]; then
    [ "$TV_RECURSE" = "1" ] || die "'$src' is a directory." \
      "Copy a directory with:  thanhvan container cp -r $src tv:$rel"
    tar -cf - -C "$src" . | docker_run tv-cp puttar "$rel" "$force"
    local rc=${PIPESTATUS[1]}
    [ "$rc" -eq 0 ] || return "$rc"
  else
    [ -r "$src" ] || die "cannot read $src."
    docker_run tv-cp put "$rel" "$mode" "$force" < "$src" || return $?
  fi
  return 0
}

# container -> host. rel is relative to $CHOME; dest is a host path.
copy_out() {
  local rel="$1" dest="$2" force="$3"
  check_rel "$rel"

  if [ "$TV_DRY_RUN" = "1" ]; then
    docker_run tv-cp get "$rel" >/dev/null
    return 0
  fi

  local kind
  kind="$(docker_run tv-cp stat "$rel" 2>/dev/null | tr -d '\r')"
  case "$kind" in
    file|dir) ;;
    *) die "'$rel' does not exist in the volume." \
           "List what is there:  thanhvan run ls -la" ;;
  esac

  # A destination that is an existing directory means "put it in here", which is
  # what cp(1) does and what everybody expects.
  if [ -d "$dest" ]; then dest="${dest%/}/$(basename "$rel")"; fi

  if [ -e "$dest" ] && [ "$force" != "1" ]; then
    die "$dest already exists." "Overwrite it with --force."
  fi

  # Checked here rather than discovered as a failed redirect below. Two causes
  # with two different fixes: the volume not having the file, and this machine
  # not having the directory. Reporting the second as the first sends people to
  # look in the wrong place entirely.
  local ddir; ddir="$(dirname "$dest")"
  [ -d "$ddir" ] || die "the destination directory does not exist: $ddir" \
                        "Create it first:  mkdir -p $ddir"

  local tmp
  if [ "$kind" = "file" ]; then
    # Never write the destination directly: an interrupted copy must not leave a
    # truncated file at a path something else is about to read.
    tmp="$dest.thanhvan.$$"
    if ! docker_run tv-cp get "$rel" > "$tmp"; then
      rm -f "$tmp"; die "could not read '$rel' out of the volume."
    fi
    mv -f "$tmp" "$dest" || { rm -f "$tmp"; die "could not write $dest."; }
  else
    [ "$TV_RECURSE" = "1" ] || die "'$rel' is a directory." \
      "Copy a directory with:  thanhvan container cp -r tv:$rel $dest"
    local work; work="$(host_tmp)"
    if ! docker_run tv-cp gettar "$rel" > "$work/x.tar"; then
      rm -rf "$work"; die "could not read '$rel' out of the volume."
    fi
    scan_tar "$work/x.tar"
    mkdir -p "$work/stage"
    tar -xf "$work/x.tar" -C "$work/stage" || { rm -rf "$work"; die "could not extract '$rel'."; }
    rm -rf "$dest"
    mv "$work/stage" "$dest" || { rm -rf "$work"; die "could not write $dest."; }
    rm -rf "$work"
  fi
  return 0
}

# --push / --pull. Both are PRE-VERB flags, and that is forced by the rule that
# passthrough argv is never parsed: thanhvan cannot reach into
# `gcloud ... --key-file=X` and rewrite X, so the user stages the file first and
# names the container path themselves.
#
#   thanhvan --push ./sa.json gcloud auth activate-service-account \
#            --key-file=data/sa.json
#
# resolves because the container's working directory is $CHOME and the push
# landed at $CHOME/data/sa.json.
push_one() {
  local spec="$1" src dest
  # Split at the LAST colon, so a host path containing one still works.
  case "$spec" in
    *:*) src="${spec%:*}"; dest="${spec##*:}" ;;
    *)   src="$spec"; dest="" ;;
  esac
  [ -n "$src" ] || die "--push needs a host path." "e.g. --push ./sa.json:$DATA_DIR/sa.json"
  [ -n "$dest" ] || dest="$DATA_DIR/$(basename "$src")"
  say "push $src -> $dest"
  copy_in "$src" "$dest" 0600 "$TV_FORCE"
}

pull_one() {
  local spec="$1" rel dest
  # Split at the FIRST colon here: the container side comes first, and container
  # paths do not contain colons the way host paths sometimes do.
  case "$spec" in
    *:*) rel="${spec%%:*}"; dest="${spec#*:}" ;;
    *)   rel="$spec"; dest="" ;;
  esac
  [ -n "$rel" ] || die "--pull needs a container path." "e.g. --pull $DATA_DIR/out.json:./out.json"
  [ -n "$dest" ] || dest="./$(basename "$rel")"
  say "pull $rel -> $dest"
  copy_out "$rel" "$dest" "$TV_FORCE"
}

do_pushes() {
  [ -n "$TV_PUSH" ] || return 0
  local spec
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    push_one "$spec"
  done <<EOF
$TV_PUSH
EOF
}

do_pulls() {
  [ -n "$TV_PULL" ] || return 0
  local spec
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    # A failed pull warns. It must NOT change the vendor's exit code; see
    # run_passthrough. `( pull_one )` so a die inside exits only the subshell.
    ( pull_one "$spec" ) || warn "--pull $spec did not complete."
  done <<EOF
$TV_PULL
EOF
  return 0
}

# --- container ------------------------------------------------------------

cmd_container_cp() {
  local -a rest
  rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -r|-R|--recursive) TV_RECURSE=1; shift ;;
      -f|--force)        TV_FORCE=1;   shift ;;
      -*) die "unknown option '$1' for 'container cp'." \
              "Try: thanhvan container cp [-r] [--force] SRC DST" ;;
      *)  rest+=( "$1" ); shift ;;
    esac
  done

  [ ${#rest[@]} -eq 2 ] || die "container cp takes exactly two paths." \
    "Into the volume:   thanhvan container cp ./sa.json tv:$DATA_DIR/sa.json" \
    "Out of the volume: thanhvan container cp tv:$DATA_DIR/out.json ./out.json"

  local src="${rest[0]}" dst="${rest[1]}"
  local src_tv=0 dst_tv=0
  case "$src" in tv:*) src_tv=1 ;; esac
  case "$dst" in tv:*) dst_tv=1 ;; esac

  if [ "$src_tv" = "1" ] && [ "$dst_tv" = "1" ]; then
    die "both paths are container paths." \
        "Copy inside the volume with:  thanhvan run cp ..."
  fi
  if [ "$src_tv" = "0" ] && [ "$dst_tv" = "0" ]; then
    die "neither path names the container." \
        "Prefix the container side with 'tv:'. This is not a host-to-host copy;" \
        "for that, use cp(1)."
  fi

  require_docker
  ensure_volume
  require_image

  if [ "$dst_tv" = "1" ]; then
    copy_in "$src" "${dst#tv:}" 0600 "$TV_FORCE"
  else
    copy_out "${src#tv:}" "$dst" "$TV_FORCE"
  fi
}

cmd_container() {
  case "${1:-}" in
    run)
      shift
      [ $# -gt 0 ] || die "container run needs a command." \
                          "Try: thanhvan run ls -la"
      require_docker; ensure_volume; require_image
      # THE BOUNDARY IS `run`. Everything after it is the container's argv,
      # verbatim -- same rule as a vendor verb, for the same reason.
      local -a TV_CMD
      if [ "$TV_TAILNET" = "1" ]; then TV_CMD=( tv-net --proxy ) ; else TV_CMD=() ; fi
      do_pushes
      if [ ${#TV_CMD[@]} -eq 0 ]; then docker_run "$@"; else docker_run "${TV_CMD[@]}" "$@"; fi
      local rc=$?
      do_pulls
      return $rc ;;
    shell)
      shift
      [ $# -eq 0 ] || die "container shell takes no arguments." \
                          "To run a command:  thanhvan run $*"
      # tv-shell, not bash. It creates ~/.local/bin -- which the image puts on
      # PATH and which is the only place a user-installed tool can survive a
      # --rm container -- and it points bash at an rc file in /etc rather than
      # one in the volume, which would be frozen at first install (rule 8).
      cmd_container run tv-shell ;;
    cp)
      shift; cmd_container_cp "$@" ;;
    '') die "container what?" \
            "  thanhvan container run <command...>" \
            "  thanhvan container shell" \
            "  thanhvan container cp [-r] [--force] SRC DST" ;;
    *)  die "unknown container subcommand '$1'." \
            "The subcommands are: run, shell, cp" ;;
  esac
}

# --- import ---------------------------------------------------------------
#
# Convenience over `container cp`, and nothing more: each one knows the path its
# tool reads and the mode that tool insists on. Both go through copy_in, so
# there is still exactly one place a container is started.

cmd_import() {
  local target="${1:-}"
  case "$target" in
    ssh-key|kubeconfig) shift ;;
    '') die "import what?" \
            "  thanhvan import ssh-key    ~/.ssh/id_ed25519" \
            "  thanhvan import kubeconfig ~/.kube/config" ;;
    *)  die "cannot import '$target'." \
            "The targets are: ssh-key, kubeconfig" ;;
  esac

  local src=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) TV_FORCE=1; shift ;;
      -*) die "unknown option '$1' for 'import $target'." ;;
      *)  [ -z "$src" ] || die "import takes one host path."; src="$1"; shift ;;
    esac
  done
  [ -n "$src" ] || die "import $target needs a host path." \
    "e.g. thanhvan import $target ~/.ssh/id_ed25519"

  require_docker; ensure_volume; require_image

  case "$target" in
    ssh-key)
      local name; name="$(basename "$src")"
      copy_in "$src" ".ssh/$name" 0600 "$TV_FORCE"
      ok "installed $CHOME/.ssh/$name"
      # The public half is not secret and is not required, but ssh-add and some
      # servers want it, and copying it is free when it is sitting right there.
      if [ -f "$src.pub" ]; then
        copy_in "$src.pub" ".ssh/$name.pub" 0644 1
        ok "installed $CHOME/.ssh/$name.pub"
      fi
      # thanhvan deliberately does not write ~/.ssh/config. A config file it
      # half-owns is a file two things edit and neither understands.
      case "$name" in
        id_rsa|id_ecdsa|id_ed25519|id_dsa) ;;
        *) bullet "Not a default key name, so name it explicitly:"
           bullet "  thanhvan ssh -i ~/.ssh/$name user@host" ;;
      esac ;;
    kubeconfig)
      copy_in "$src" ".kube/config" 0600 "$TV_FORCE"
      ok "installed $CHOME/.kube/config"
      bullet "Merging several kubeconfigs is out of scope; import the merged one." ;;
  esac
}

# --- clean ----------------------------------------------------------------

cmd_clean() {
  require_docker; ensure_volume; require_image
  heading "Clean"
  bullet "Removes $CHOME/$DATA_DIR, where --push and 'container cp' put things."
  bullet "Credentials live elsewhere in the volume and are not touched."
  # confirm, not confirm_phrase: this is recoverable by pushing the files again.
  # confirm_phrase is reserved for the volume delete, which is not.
  if confirm "Remove everything under $CHOME/$DATA_DIR?" n; then
    docker_run tv-cp clean "$DATA_DIR" && ok "removed $CHOME/$DATA_DIR"
  else
    skip "kept $CHOME/$DATA_DIR"
  fi
  return 0
}

# --- passthrough ----------------------------------------------------------

is_verb() {
  local v
  for v in $PASSTHROUGH_VERBS; do [ "$1" = "$v" ] && return 0; done
  return 1
}

# The container command for a verb, as an array, into TV_CMD.
#
# Two verbs are never run directly. `tailscale` cannot do anything without a
# daemon, and `ssh` cannot reach a tailnet address without one -- the network
# stack is inside the tailscaled process, so there is no kernel route to
# 100.64.0.0/10 for connect(2) to use. Both go through tv-net, which starts one
# daemon, runs the command and kills it again.
#
# --tailnet does the same for any other verb and additionally points HTTPS_PROXY
# at tailscaled's SOCKS5 listener. That is deliberately opt-in: it routes ALL of
# that command's traffic through the daemon, which is wrong for a kubectl aimed
# at a public GKE endpoint. ssh needs no such flag because its routing is
# per-host, in /etc/ssh/ssh_config.d.
#
# Bash 3.2 has no `local -n`, so this assigns a global rather than returning.
container_cmd_for() {
  case "$1" in
    tailscale) TV_CMD=( tv-net tailscale ) ;;
    ssh)       TV_CMD=( tv-net ssh ) ;;
    *) if [ "$TV_TAILNET" = "1" ]; then TV_CMD=( tv-net --proxy "$1" )
       else TV_CMD=( "$1" ); fi ;;
  esac
}

run_passthrough() {
  local verb="$1"; shift
  require_docker
  ensure_volume
  require_image

  local -a TV_CMD
  container_cmd_for "$verb"

  do_pushes

  docker_run "${TV_CMD[@]}" "$@"
  local rc=$?

  # RULE: THE VENDOR'S EXIT CODE PROPAGATES UNCHANGED.
  #
  # A --pull that fails warns and does not touch rc. Every script wrapping
  # thanhvan reads that status as the vendor's, and a copy step quietly
  # rewriting it is the kind of bug that only shows up in someone else's CI.
  do_pulls

  return $rc
}

# --- setup workstation ----------------------------------------------------

# Each check reads what the tool itself reports, never a marker file recording
# that setup once ran. A marker goes stale the moment somebody runs
# `docker image prune` or `docker volume rm`, and it fails as a false OK.
gcloud_account() { docker_run gcloud auth list --filter=status:ACTIVE --format="value(account)" 2>/dev/null | tr -d '\r'; }
gcloud_adc_ok()  { docker_run gcloud auth application-default print-access-token >/dev/null 2>&1; }
gh_login_name()  { docker_run gh api user --jq .login 2>/dev/null | tr -d '\r'; }
ts_state()       { docker_run tv-net tailscale status --json 2>/dev/null | tr -d '\r' | sed -n 's/.*"BackendState"[ ]*:[ ]*"\([A-Za-z]*\)".*/\1/p' | head -1; }
cf_cert_ok()     { docker_run test -f "$CHOME/.cloudflared/cert.pem" >/dev/null 2>&1; }
ssh_keys()       { docker_run tv-cp ls .ssh 2>/dev/null | tr -d '\r' | grep -v '\.pub$' | grep -v '^known_hosts$' | grep -v '^config$'; }
kubeconfig_ok()  { [ "$(docker_run tv-cp stat .kube/config 2>/dev/null | tr -d '\r')" = "file" ]; }

setup_logins() {
  local interactive=1
  [ -t 0 ] || interactive=0

  heading "Google"
  local account; account="$(gcloud_account)"
  if [ -n "$account" ]; then
    ok "signed in as $account"
  else
    miss "not signed in"
    if [ "$interactive" = "1" ]; then
      # --no-launch-browser, NOT --no-browser. The latter prints a
      # `gcloud auth login --remote-bootstrap=...` command to run on a machine
      # that already has gcloud and a browser -- and the entire point of this
      # design is that this machine has no gcloud. --no-launch-browser prints a
      # URL and waits on stdin for the code, which is what a pty gives us.
      docker_run gcloud auth login --no-launch-browser || warn "gcloud sign-in did not complete."
    else
      bullet "Run 'thanhvan setup workstation' from a terminal to sign in."
    fi
  fi

  if gcloud_adc_ok; then
    ok "Application Default Credentials present"
  else
    miss "no Application Default Credentials"
    # The step the runbook loses most often. `gcloud auth login` writes the
    # CLI's own credentials; `gcloud auth application-default login` writes the
    # ADC that libraries and Terraform actually read. Two commands, both needed,
    # and the first one succeeding tells you nothing about the second.
    bullet "Separate from the sign-in above, and easy to miss: anything using a"
    bullet "Google client library reads ADC, not the CLI's own credentials."
    if [ "$interactive" = "1" ]; then
      docker_run gcloud auth application-default login --no-launch-browser \
        || warn "application-default login did not complete."
    fi
  fi

  heading "GitHub"
  local who; who="$(gh_login_name)"
  if [ -n "$who" ]; then
    ok "authenticated as $who"
  else
    miss "not authenticated"
    if [ "$interactive" = "1" ]; then
      # --web picks the device flow directly and skips the "how would you like to
      # authenticate" menu, which cannot be navigated usefully here.
      # --git-protocol https avoids the SSH-keygen branch, which would generate a
      # key inside the volume that nothing ever uses.
      docker_run gh auth login --hostname github.com --git-protocol https --web \
        || warn "GitHub sign-in did not complete."
    else
      bullet "Run 'thanhvan setup workstation' from a terminal to sign in."
    fi
  fi

  heading "Tailscale"
  local state; state="$(ts_state)"
  if [ "$state" = "Running" ]; then
    ok "logged in"
  else
    miss "not logged in${state:+ ($state)}"
    bullet "The container joins the tailnet; this machine does not."
    if [ "$interactive" = "1" ]; then
      # `tv-net tailscale`, not `tv-tailscale`. There is no such binary in the
      # image, and this line named it for two releases: the CLI is a client for
      # a daemon over a unix socket, so it needs tv-net to start one exactly the
      # way the `tailscale` verb does. Nothing caught it because the whole path
      # is interactive and the test stub exits 0 for any `docker run`.
      docker_run tv-net tailscale login || warn "Tailscale login did not complete."
    fi
  fi

  heading "Cloudflare"
  if cf_cert_ok; then
    ok "origin certificate present"
  else
    miss "no origin certificate"
    if [ "$interactive" = "1" ]; then
      docker_run cloudflared tunnel login || warn "cloudflared login did not complete."
    fi
  fi

  # These two are NOT logins. There is nothing to sign in to and nothing to
  # prompt for -- a key and a kubeconfig are host files the user copies in when
  # they have one. Reported, never attempted, and never a failure: a new joiner
  # has neither, and rule 9 says that is not a broken command.
  heading "SSH"
  local keys; keys="$(ssh_keys)"
  if [ -n "$keys" ]; then
    ok "$(printf '%s\n' "$keys" | wc -l | tr -d ' ') key(s) in $CHOME/.ssh"
  else
    miss "no private key"
    bullet "thanhvan import ssh-key ~/.ssh/id_ed25519"
  fi

  heading "Kubernetes"
  if kubeconfig_ok; then
    ok "kubeconfig present"
  else
    miss "no kubeconfig"
    bullet "thanhvan import kubeconfig ~/.kube/config"
  fi
}

setup_workstation() {
  local do_login=1 do_pull=0 do_uninstall=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --skip-login) do_login=0; shift ;;
      --pull)       do_pull=1;  shift ;;
      --uninstall)  do_uninstall=1; shift ;;
      *) die "unknown option '$1' for 'setup workstation'." \
             "Try: thanhvan setup workstation [--skip-login] [--pull] [--uninstall]" ;;
    esac
  done

  [ "$do_uninstall" = "1" ] && { uninstall; return $?; }

  detect
  heading "Machine"
  ok "os               $TV_OS/$TV_ARCH"
  ok "mode             $TV_MODE"
  ok "image            $(image_ref)"
  ok "volume           $(volume_name)"

  heading "Docker"
  require_docker
  ok "daemon reachable"
  ensure_volume
  ok "volume $(volume_name)"

  if [ "$do_pull" = "1" ] || ! image_present; then
    if [ "$do_pull" = "0" ]; then
      miss "image not present"
      bullet "About 800MB, once. Every tool thanhvan can run is in it."
    fi
    pull_image
  fi
  ok "image $(image_ref)"

  if [ "$do_login" = "1" ]; then
    setup_logins
  else
    heading "Logins"
    skip "--skip-login"
  fi

  write_shell_block

  heading "Next"
  bullet "thanhvan gcloud projects list"
  bullet "thanhvan gh api user"
  bullet "thanhvan tailscale status"
  bullet "thanhvan cloudflared tunnel list"
  detect
  [ -n "$TV_RC" ] && bullet "Reload your shell:  exec $TV_SHELL -l"

  # Blockers are reported, never raised: a service that could not be reached is
  # somebody else's problem to unblock, and exiting non-zero would read as "the
  # command is broken" on a first run when nothing is broken.
  return 0
}

uninstall() {
  heading "Uninstall"
  remove_shell_block
  ok "removed the PATH block"

  local name; name="$(volume_name)"
  if command -v docker >/dev/null 2>&1 && docker volume inspect "$name" >/dev/null 2>&1; then
    warn "the volume '$name' holds every credential you have signed in with:"
    bullet "gcloud credentials and ADC, the gh token, the tailnet node key,"
    bullet "and the cloudflared origin certificate."
    bullet "Removing it means signing in to all four again."
    if confirm_phrase "Delete the volume and every stored credential?" "delete"; then
      docker volume rm "$name" >/dev/null && ok "removed volume $name"
    else
      skip "kept volume $name"
    fi
  fi

  bullet "Left in place on purpose: the image (docker rmi $(image_ref) to remove it)"
  bullet "and Docker itself."
  return 0
}

# --- self-update ----------------------------------------------------------
#
# The versioned install layout is what makes this safe, and is the only reason
# a script can replace itself at all:
#
#   ~/.local/bin/thanhvan -> <share>/current/bin/thanhvan
#                         -> <share>/versions/<v>/bin/thanhvan
#
# update NEVER writes to the file it is currently executing. It installs the new
# launcher beside the old one under versions/<new>/ and flips `current` last, so
# a failure anywhere before the flip leaves the previous version in place AND
# still selected. Overwriting in place would instead corrupt a running bash --
# which reads the script incrementally, so a rewritten tail is executed as if it
# had always been there.

sha256_of() {
  # macOS has shasum, not sha256sum. Same split install.sh makes, for the same
  # reason, and the reason this is a function rather than two inline branches.
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

share_dir() {
  # CLI_ROOT is <share>/versions/<v>, so <share> is two levels up.
  #
  # DERIVED, never assumed to be ~/.local/share/thanhvan: somebody who set
  # XDG_DATA_HOME gets their own tree updated, and somebody whose layout does
  # not look like the installer's gets told to re-run the installer instead of
  # having a versions/ tree written into a directory that is not one.
  local d=""
  d=$(cd -P "$CLI_ROOT/../.." 2>/dev/null && pwd) || return 1
  [ -d "$d/versions" ] || return 1
  [ -L "$d/current" ]  || return 1
  printf '%s' "$d"
}

cmd_update() {
  local check_only=0 reinstall=0 want_image=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --check)     check_only=1; shift ;;
      --reinstall) reinstall=1;  shift ;;
      --no-image)  want_image=0; shift ;;
      # Not --force: that is already a global flag meaning "overwrite the
      # destination when copying". One flag with two meanings is unguessable.
      *) die "unknown option '$1' for 'update'." \
             "Try: thanhvan update [--check] [--reinstall] [--no-image]" ;;
    esac
  done

  if [ "$TV_MODE" = "dev" ]; then
    die "this is a git checkout, not an installed copy." \
        "update replaces an installed launcher. Here, git is the update:" \
        "" \
        "  git -C $CLI_ROOT pull"
  fi

  command -v curl >/dev/null 2>&1 \
    || die "curl is needed to check for updates, and is not on this machine."

  local share=""
  share=$(share_dir) || die "this install is not laid out the way update expects." \
      "It looks for <dir>/versions/<version>/bin/thanhvan next to a 'current'" \
      "symlink, and this launcher resolved to $CLI_ROOT." \
      "" \
      "  curl -fsSL $UPDATE_BASE_URL/install.sh | bash"

  heading "Update"
  ok "installed        $THANHVAN_VERSION"

  TV_UPD_TMP="$(host_tmp)" || die "could not create a temporary directory."
  # One trap covers every path out, including the die()s below, which exit
  # rather than returning. It reads a GLOBAL -- see TV_UPD_TMP's declaration.
  trap '[ -n "$TV_UPD_TMP" ] && rm -rf "$TV_UPD_TMP"' EXIT

  say "  checking $UPDATE_BASE_URL"
  curl -fsSL "$UPDATE_BASE_URL/thanhvan" -o "$TV_UPD_TMP/thanhvan" \
    || die "could not download the launcher from $UPDATE_BASE_URL/thanhvan" \
           "Nothing was changed."
  curl -fsSL "$UPDATE_BASE_URL/thanhvan.sha256" -o "$TV_UPD_TMP/thanhvan.sha256" \
    || die "could not download the checksum. Refusing to install unverified." \
           "Nothing was changed."

  # VERIFY BEFORE READING ANYTHING OUT OF IT, version string included. Every
  # line below this point treats the file as trusted; nothing above it may.
  local want="" got=""
  want=$(awk '{print $1; exit}' "$TV_UPD_TMP/thanhvan.sha256")
  got=$(sha256_of "$TV_UPD_TMP/thanhvan")
  [ -n "$want" ] || die "the checksum file is empty. Refusing to install unverified." \
                        "Nothing was changed."
  [ "$want" = "$got" ] || die "checksum mismatch." \
      "  expected $want" \
      "  got      $got" \
      "The download is corrupt or has been tampered with. Nothing was changed."

  local new=""
  new=$(grep -E '^THANHVAN_VERSION=' "$TV_UPD_TMP/thanhvan" | head -1 | cut -d'"' -f2)
  [ -n "$new" ] || die "the downloaded launcher has no THANHVAN_VERSION." \
                       "Refusing to install it. Nothing was changed."
  # The version becomes a directory name. Checked even though the checksum has
  # already passed, because the cost is one line and the failure is a write
  # outside the versions/ tree.
  case "$new" in
    *[!A-Za-z0-9._-]*|.|..) die "the downloaded launcher reports an unusable version '$new'." \
                                "Nothing was changed." ;;
  esac
  ok "published        $new"

  # No version arithmetic, on purpose. The channel is the source of truth for
  # what "latest" is; comparing two version strings correctly in bash 3.2 is a
  # subtle job whose only payoff would be second-guessing it.
  if [ "$new" = "$THANHVAN_VERSION" ] && [ "$reinstall" = "0" ]; then
    ok "already up to date"
    return 0
  fi
  if [ "$check_only" = "1" ]; then
    say ""
    bullet "Install it:  thanhvan update"
    return 0
  fi

  local new_image="${THANHVAN_IMAGE:-$IMAGE_REPO:$new}"
  if [ "$TV_DRY_RUN" = "1" ]; then
    say "dry-run: install $new to $share/versions/$new/bin/thanhvan"
    say "dry-run: point $share/current at versions/$new"
    [ "$want_image" = "1" ] && say "dry-run: docker pull $new_image"
    return 0
  fi

  # The launcher that is running was reached by walking symlinks from $0, which
  # need not be the one `current` selects. If it is not, flipping `current` will
  # not change what the next `thanhvan` runs -- and the update would report
  # success while doing nothing the user can see.
  local cur=""
  cur=$(cd -P "$share/current" 2>/dev/null && pwd) || cur=""
  if [ -n "$cur" ] && [ "$cur" != "$CLI_ROOT" ]; then
    warn "the running launcher is $CLI_ROOT, but 'current' selects $cur."
    bullet "Updating the tree anyway; if 'thanhvan' still reports the old version,"
    bullet "reinstall:  curl -fsSL $UPDATE_BASE_URL/install.sh | bash"
  fi

  mkdir -p "$share/versions/$new/bin" \
    || die "could not create $share/versions/$new/bin. Nothing was changed."

  # STAGE UNDER A TEMPORARY NAME, THEN RENAME. Never `cp` onto the final path.
  #
  # With --reinstall, `$new` IS the running version, so that final path is the
  # file this process is executing -- and `cp` writes THROUGH to the existing
  # inode. bash reads a script incrementally and seeks back into it between
  # top-level commands, so a rewritten file is executed as though it had always
  # been that way: the rest of this function is read out of the NEW file at the
  # OLD offset, mid-line. rename(2) swaps the directory entry instead and leaves
  # the running inode alone, which is the whole reason update installs beside
  # the old launcher rather than over it.
  local staged="$share/versions/$new/bin/.thanhvan.$$"
  cp "$TV_UPD_TMP/thanhvan" "$staged" \
    || die "could not write $share/versions/$new/bin/thanhvan. Nothing was changed."
  chmod +x "$staged" \
    || { rm -f "$staged"
         die "could not make the new launcher executable. Nothing was changed."; }

  # It has to actually run BEFORE it is the one everybody gets, and before it
  # takes the name anything else resolves. `--version` is the cheapest whole-file
  # exercise there is: bash parses the entire script before executing a line of
  # it, so a truncated or mangled launcher fails here rather than on somebody's
  # next command. Verified while still staged, so a bad download never occupies
  # the real path even for an instant -- with --reinstall that path is the only
  # working launcher on the machine.
  local reported=""
  reported=$("$staged" --version 2>/dev/null) \
    || { rm -f "$staged"
         die "the newly downloaded launcher does not run. Nothing was changed."; }
  case "$reported" in
    "thanhvan $new") ;;
    *) rm -f "$staged"
       die "the new launcher reports '$reported', expected 'thanhvan $new'." \
           "Nothing was changed." ;;
  esac

  mv -f "$staged" "$share/versions/$new/bin/thanhvan" \
    || { rm -f "$staged"
         die "could not install $share/versions/$new/bin/thanhvan. Nothing was changed."; }

  # Repoint `current`. THE -n IS THE WHOLE FLAG: without it ln FOLLOWS the
  # existing `current` symlink to the directory it names and creates the new
  # link INSIDE it -- versions/<old>/current -- so `current` still selects the
  # old version, and ln exits 0.
  #
  # Staging a link under a temporary name and `mv -f`ing it over `current` has
  # EXACTLY the same bug for exactly the same reason: mv stats the destination
  # through the symlink, sees a directory, and moves the staged link into it.
  # `mv -T` avoids that and is a GNU-ism macOS does not have. Both spellings
  # look atomic, both report success, and both leave an update that prints
  # "thanhvan <new>" while the next command still runs the old one.
  ln -sfn "versions/$new" "$share/current" \
    || die "could not repoint 'current' to versions/$new." \
           "versions/$new is installed; nothing else was changed."

  # Read back what was just written, because the failure above is a SILENT
  # no-op: the only way to tell it apart from success is to ask where `current`
  # actually points now. Rule 11 -- a check reads the thing, not a proxy for it.
  local sel=""
  sel=$(cd -P "$share/current" 2>/dev/null && pwd) || sel=""
  [ "$sel" = "$share/versions/$new" ] \
    || die "'current' selects ${sel:-nothing} after being repointed at versions/$new." \
           "The new launcher is installed but not selected, so 'thanhvan' still" \
           "runs $THANHVAN_VERSION. Reinstall:" \
           "  curl -fsSL $UPDATE_BASE_URL/install.sh | bash"

  ok "thanhvan $new    ($share/current -> versions/$new)"

  # The image is tagged per version, so the new launcher's image is a different
  # tag that this machine does not have yet. Pulling it here is the difference
  # between an update that finishes and one whose next command dies with "the
  # image is not present" -- and unlike a passthrough command, the user asked
  # for this and is watching it.
  if [ "$want_image" = "1" ]; then
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
      if docker image inspect "$new_image" >/dev/null 2>&1; then
        ok "image $new_image"
      else
        say "  pulling $new_image (about 800MB, once)"
        pull_image "$new_image"
        ok "image $new_image"
      fi
    else
      # Not fatal: the launcher IS updated, and that is what was asked for.
      warn "docker is not reachable, so the image for $new was not pulled."
      bullet "Get it when docker is up:  thanhvan setup workstation --pull"
    fi
  else
    skip "--no-image; run 'thanhvan setup workstation --pull' to fetch it"
  fi

  # The old version is left in versions/ deliberately: it is a few tens of KB,
  # and it is the only thing standing between a bad release and a machine with
  # no working thanhvan on it.
  heading "Done"
  bullet "$THANHVAN_VERSION -> $new"
  bullet "The previous version is kept at $share/versions/$THANHVAN_VERSION"
  return 0
}

# --- usage ----------------------------------------------------------------

usage() {
  cat >&2 <<EOF
${C_BOLD}thanhvan${C_OFF} -- one front door to gcloud, gh, tailscale, cloudflared, ssh,
kubectl, git, helm, jq and yq.

Every tool runs in a container. Nothing but Docker is installed on this machine,
no host directory is mounted, and all credentials live in the '$(volume_name)'
docker volume.

${C_BOLD}usage${C_OFF}
  thanhvan setup workstation [--skip-login] [--pull] [--uninstall]
  thanhvan gcloud      <args...>      thanhvan git   <args...>
  thanhvan gh          <args...>      thanhvan helm  <args...>
  thanhvan tailscale   <args...>      thanhvan jq    <args...>
  thanhvan cloudflared <args...>      thanhvan yq    <args...>
  thanhvan ssh         <args...>
  thanhvan kubectl     <args...>

  thanhvan update [--check] [--reinstall] [--no-image]

  thanhvan run <command...>                 run anything in the container
  thanhvan shell                            an interactive shell in it
  thanhvan container cp [-r] SRC DST        copy, one side prefixed 'tv:'
  thanhvan import ssh-key    <hostpath>     -> $CHOME/.ssh/
  thanhvan import kubeconfig <hostpath>     -> $CHOME/.kube/config
  thanhvan clean                            empty $CHOME/$DATA_DIR

${C_BOLD}examples${C_OFF}
  thanhvan setup workstation          pull the image and sign in
  thanhvan update                     upgrade to the latest published version
  thanhvan update --check             say what is available, change nothing
  thanhvan gcloud projects list
  thanhvan gh pr list
  thanhvan tailscale status
  thanhvan ssh admin@host.ts.net      tailnet hosts route automatically
  thanhvan --tailnet kubectl get pods for an API server on the tailnet
  thanhvan container cp ./sa.json tv:$DATA_DIR/sa.json
  thanhvan container cp tv:$DATA_DIR/out.json ./out.json
  thanhvan shell                      install a tool of your own -- see notes

${C_BOLD}options${C_OFF}
  Global flags go BEFORE the verb; everything after a verb belongs to that tool.

  -n, --dry-run     print the docker command, start nothing
  -q, --quiet       only warnings and errors
  -y, --yes         assume yes (never accepts a typed-phrase confirmation)
      --force       overwrite an existing destination when copying
      --tailnet     bring the tailnet up and proxy this command through it
      --push SRC[:DEST]   copy a host file in before running (DEST under $DATA_DIR/)
      --pull SRC[:DEST]   copy a container file out afterwards
      --version     print the version
      --detect      print what this machine looks like, machine-readably

${C_BOLD}notes${C_OFF}
  No host directory is mounted, so a flag that reads a local file cannot see it
  on its own. Stage it first -- thanhvan reads the file here and streams it in;
  the container never gets to look at your disk:

    thanhvan --push ./sa.json gcloud auth activate-service-account \\
             --key-file=$DATA_DIR/sa.json

  Pushed files stay in the volume until 'thanhvan clean'.

  For a tool that is not in the image: the container runs as a normal user with
  no way to become root, so there is no apt and no sudo. Install it as yourself,
  into ~/.local/bin -- that is on PATH and inside the volume, so it is still
  there next time:

    thanhvan shell
    curl -fsSL <url> | tar -xz -C ~/.local/bin <name>
    exit
    thanhvan run <name> --version

  Tools that ship with thanhvan take precedence over anything of the same name
  in ~/.local/bin, so your own copy of kubectl cannot silently replace the one
  'thanhvan kubectl' runs.
EOF
}

# --- dispatch -------------------------------------------------------------
#
# THE BOUNDARY IS THE VERB. Everything before it is thanhvan's; everything after
# it is handed to the vendor CLI verbatim -- not parsed, not filtered, not
# reordered. That is the only rule under which
#
#     thanhvan gcloud compute instances list --format=json -v
#
# can mean what it says. The previous CLI hoisted global flags out of anywhere in
# the line, which would have silently eaten that -v and turned it into thanhvan
# verbosity.
#
# The cost, and it is the right one: `thanhvan gcloud ... --dry-run` is gcloud's
# flag, not ours. A flag that belongs sometimes to one program and sometimes to
# another is unguessable, and all four vendors define flags that collide.

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) TV_DRY_RUN=1; shift ;;
      -q|--quiet)   TV_QUIET=1;   shift ;;
      -y|--yes)     TV_YES=1;     shift ;;
      -v|--verbose) TV_TRACE=1;   shift ;;
      --tailnet)    TV_TAILNET=1; shift ;;
      --force)      TV_FORCE=1;   shift ;;
      --push) [ $# -ge 2 ] || die "--push needs a host path."
              TV_PUSH="$TV_PUSH${TV_PUSH:+$NL}$2"; shift 2 ;;
      --pull) [ $# -ge 2 ] || die "--pull needs a container path."
              TV_PULL="$TV_PULL${TV_PULL:+$NL}$2"; shift 2 ;;
      *) break ;;
    esac
  done

  local cmd="${1:-}"

  if [ -n "$cmd" ] && is_verb "$cmd"; then
    shift
    run_passthrough "$cmd" "$@"
    return $?
  fi

  case "$cmd" in
    setup)
      shift
      case "${1:-}" in
        workstation) shift; setup_workstation "$@" ;;
        '') die "setup what?" "Try: thanhvan setup workstation" ;;
        *)  die "cannot set up '$1'." "The only target is: thanhvan setup workstation" ;;
      esac ;;
    update)    shift; cmd_update "$@" ;;
    container) shift; cmd_container "$@" ;;
    # Aliases for the two `container` subcommands people reach for constantly:
    # `run` is how a tool the user installed themselves is invoked, and `shell`
    # is how they install it. Dispatched HERE and not through PASSTHROUGH_VERBS
    # -- a verb hands everything after itself to a program of that name, and
    # there is no program called `run`.
    run)       shift; cmd_container run "$@" ;;
    shell)     shift; cmd_container shell "$@" ;;
    import)    shift; cmd_import "$@" ;;
    clean)     shift
               [ $# -eq 0 ] || die "clean takes no arguments." "Try: thanhvan clean"
               cmd_clean ;;
    --version|-V) printf 'thanhvan %s\n' "$THANHVAN_VERSION" ;;
    --detect)     detect_report ;;
    --uninstall-shell-block) remove_shell_block ;;
    ''|--help|-h|help) usage ;;
    *) die "unknown command '$cmd'." \
           "The tools are: gcloud, gh, tailscale, cloudflared, ssh, kubectl, git, helm, jq, yq" \
           "For anything else in the container:  thanhvan run $cmd" \
           "Try: thanhvan --help" ;;
  esac
}

main "$@"
